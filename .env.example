# =============================================================================
# SUPABASE / POSTGRESQL CONFIGURATION
# =============================================================================

# Option 1: Supabase Direct or Pooled Connection String (Recommended)
# Copy from Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI
# Example (Session Pooler - Port 6543):
# DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Example (Direct Connection - Port 5432):
# DATABASE_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres?sslmode=require

DATABASE_URL=

# Option 2: Individual Parameters (if not using DATABASE_URL):
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password
# POSTGRES_HOST=db.yourprojectref.supabase.co
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres

# Application Security
SECRET_KEY=traffic-violation-logger-secret-key-2026
