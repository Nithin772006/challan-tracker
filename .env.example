# PostgreSQL Database Configuration
# You can specify a full connection URL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/traffic_logger

# Or configure individual credentials:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=traffic_logger

# Application Security
SECRET_KEY=traffic-violation-logger-secret-key-2026
